[Unit]
Description=Farvater OpenConnect server %i
PartOf=okopy-candidate.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/opt/farvater/engines/ocserv/current/usr/lib/x86_64-linux-gnu
ExecStart=/opt/farvater/engines/ocserv/current/usr/sbin/ocserv -f -c /run/farvater-ocserv/%i/ocserv.conf
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/run/farvater-ocserv/%i
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
UMask=0077
